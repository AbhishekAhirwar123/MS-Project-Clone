# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string: Atlas › your cluster › Connect › Drivers.
# Replace <password> with the database user's password (URL-encode special characters).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=neoproject

# Used once by `npm run seed:admin` to create the first admin account.
# Remove ADMIN_PASSWORD from this file after seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# Local API port (Vite forwards /api to it).
API_PORT=3001
